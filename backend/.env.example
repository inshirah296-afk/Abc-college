# Copy this file to .env and fill in your own values. Never commit the real .env file.

# MongoDB connection string
# Local example:      mongodb://127.0.0.1:27017/abc_college_events
# Atlas example:       mongodb+srv://<user>:<password>@cluster0.mongodb.net/abc_college_events
MONGODB_URI=mongodb://127.0.0.1:27017/abc_college_events

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Port the API server listens on
PORT=5000

# Default admin account created by the seed script
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@abccollege.edu
ADMIN_PASSWORD=Admin@123

# Comma separated list of origins allowed to call the API (for CORS)
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
